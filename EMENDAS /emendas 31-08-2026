}
function toggleSidebar(f){const s=document.getElementById('sidebar'),o=document.querySelector('.sidebar-overlay');const v=f!==undefined?f:!s.classList.contains('open');s.classList.toggle('open',v);o.classList.toggle('show',v);}
function toggleCollapse(){const s=document.getElementById('sidebar');if(window.innerWidth<769){toggleSidebar(false);}else{s.classList.toggle('collapsed');localStorage.setItem('sidebarCollapsed',s.classList.contains('collapsed')?'1':'0');}}
