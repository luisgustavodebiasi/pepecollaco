// AUDIO WHATSAPP - pointer events (touch + mouse)
let recStream=null,recTI=null,recSec=0,isRec=false,recCancel=false,holdTO=null;
function setupMic(){
    const btn=document.getElementById('btnGravar');if(!btn)return;let sy=0;
    btn.addEventListener('pointerdown',e=>{e.preventDefault();btn.setPointerCapture(e.pointerId);recCancel=false;sy=e.clientY;holdTO=setTimeout(()=>startRec(),150);});
    btn.addEventListener('pointermove',e=>{if(!isRec)return;const dy=sy-e.clientY;const h=document.getElementById('recHint');if(dy>60){recCancel=true;if(h)h.textContent='↑ Solte para cancelar';btn.style.opacity='0.5';}else{recCancel=false;if(h)h.textContent='Solte para enviar';btn.style.opacity='1';}});
    btn.addEventListener('pointerup',e=>{clearTimeout(holdTO);if(isRec)stopRec(false);});
    btn.addEventListener('pointercancel',e=>{clearTimeout(holdTO);if(isRec)stopRec(true);});
    btn.addEventListener('contextmenu',e=>e.preventDefault());
}
async function startRec(){
    try{recStream=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:true,noiseSuppression:true}});
    const mt=MediaRecorder.isTypeSupported('audio/webm;codecs=opus')?'audio/webm;codecs=opus':MediaRecorder.isTypeSupported('audio/mp4')?'audio/mp4':'';
    mediaRecorder=new MediaRecorder(recStream,mt?{mimeType:mt}:{});audioChunks=[];
    mediaRecorder.ondataavailable=e=>{if(e.data.size>0)audioChunks.push(e.data);};
    mediaRecorder.onstop=async()=>{recStream.getTracks().forEach(t=>t.stop());recStream=null;if(recCancel||recSec<1){updMicUI(0);toast(recCancel?'Gravação cancelada':'Segure mais tempo',2000);return;}updMicUI(0);
        const ext=mt.includes('mp4')?'mp4':'webm';const blob=new Blob(audioChunks,{type:mt||'audio/webm'});document.getElementById('iaLoading').classList.remove('hidden');
        const fd=new FormData();fd.append('action','transcrever');fd.append('audio',blob,'audio.'+ext);
        try{const resp=await fetch(API+'ia.php',{method:'POST',body:fd});const d=await resp.json();if(d.texto){document.getElementById('iaTexto').value=d.texto;toast('Áudio transcrito!');enviarTextoIA();}else throw new Error(d.error||'Falha');}catch(e){toast('Erro: '+e.message,5000);document.getElementById('iaLoading').classList.add('hidden');}};
    mediaRecorder.start();isRec=true;recSec=0;updMicUI(1);
    recTI=setInterval(()=>{recSec++;const m=Math.floor(recSec/60),s=recSec%60;const el=document.getElementById('recTimer');if(el)el.textContent=m+':'+String(s).padStart(2,'0');if(recSec>=120)stopRec(false);},1000);
    if(navigator.vibrate)navigator.vibrate(50);
    }catch(e){toast('Permita acesso ao microfone',4000);isRec=false;}
}
function stopRec(c){clearInterval(recTI);recCancel=c;isRec=false;if(mediaRecorder&&mediaRecorder.state==='recording')mediaRecorder.stop();if(navigator.vibrate)navigator.vibrate(30);const b=document.getElementById('btnGravar');if(b)b.style.opacity='1';}
function updMicUI(on){const b=document.getElementById('btnGravar'),g=document.getElementById('iaGravando'),l=document.getElementById('micLabel'),h=document.getElementById('recHint');if(on){b.classList.add('recording');g.classList.remove('hidden');if(l)l.textContent='Gravando...';if(h)h.textContent='Solte para enviar';}else{b.classList.remove('recording');g.classList.add('hidden');if(l)l.textContent='Segure para gravar';const t=document.getElementById('recTimer');if(t)t.textContent='0:00';}}

