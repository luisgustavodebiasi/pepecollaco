const API='api/';
let currentPage='dashboard', emendaPage=1, relPage=1, cacheSelects={}, iaResultado=null, mediaRecorder=null, audioChunks=[];
let eSortCol=null, eSortDir='asc', rSortCol=null, rSortDir='asc';
let eData=[], rData=[];
