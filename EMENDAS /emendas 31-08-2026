function b64urlToBuffer(b){const s=b.replace(/-/g,'+').replace(/_/g,'/');const p='='.repeat((4-s.length%4)%4);const d=atob(s+p);return Uint8Array.from(d,c=>c.charCodeAt(0));}
function bufferToB64url(b){const a=new Uint8Array(b);let s='';a.forEach(x=>s+=String.fromCharCode(x));return btoa(s).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');}

