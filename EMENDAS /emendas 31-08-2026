}

function aplicarGeoJSON(){
    mapaCamadasPorGrupo={};
    
    // === TWO-PASS matching to prevent one city appearing on two polygons ===
    const features=mapaGeoData.features||[];
    const cidadesJaCasadas=new Set();
    
    // PASS 1: Match by NAME (most reliable - correct polygon guaranteed)
    features.forEach(feat=>{
        const props=feat.properties||{};
        props._matchedCity=null; // reset
        let geoName=mapaNormalizarNome(props.name);
        if(!geoName) return;
        let found=mapaDadosCidadesNome[geoName];
        if(!found){
            const alias=mapaAliases[geoName];
            if(alias) found=mapaDadosCidadesNome[alias];
        }
        if(!found){
            const fuzzy=geoName.replace(/ D[AEIO]S? /g,' ').replace(/\s+/g,' ');
            if(fuzzy!==geoName) found=mapaDadosCidadesNome[fuzzy];
        }
        if(found){
            props._matchedCity=found;
            cidadesJaCasadas.add(found.id);
        }
    });
    
    // PASS 2: IBGE fallback ONLY for unmatched features AND unclaimed cities
    features.forEach(feat=>{
        const props=feat.properties||{};
        if(props._matchedCity) return;
        const code=props.id;
        if(code&&mapaDadosCidades[code]){
            const cidade=mapaDadosCidades[code];
            if(!cidadesJaCasadas.has(cidade.id)){
                props._matchedCity=cidade;
                cidadesJaCasadas.add(cidade.id);
            }
        }
    });
    
    let unmatchCount=0;
    mapaGeoJSON=L.geoJSON(mapaGeoData,{
        style:function(feature){
            const info=(feature.properties||{})._matchedCity;
            const cor=mapaGetCorCidade(info);
            return{color:'#cbd5e1',weight:1,fillColor:cor||'#e2e8f0',fillOpacity:cor?0.75:0.3};
        },
        onEachFeature:function(feature,layer){
            const info=(feature.properties||{})._matchedCity;
            if(info){
                const grupo=mapaGetGrupoNome(info);
                const grupoLabel=mapaModo==='associacao'?'Assoc.':'Região';
                layer.bindTooltip(`<b>${info.nome}</b><br>${grupoLabel}: ${grupo||'—'}`,{sticky:true});
                const key=grupo||'SEM_GRUPO';
                if(!mapaCamadasPorGrupo[key])mapaCamadasPorGrupo[key]=[];
                mapaCamadasPorGrupo[key].push({poligono:layer,nome:info.nome,id:info.id,grupoId:mapaGetGrupoId(info)});
                layer.on('click',()=>mapaClicarCidade(info.id,info.nome));
            } else {
                unmatchCount++;
                const p=feature.properties||{};
                layer.bindTooltip(`<b>${p.name||'?'}</b><br><i>Sem cadastro</i>`,{sticky:true});
            }
        }
    }).addTo(mapaLeaflet);
    if(unmatchCount>0) console.info(`Mapa: ${unmatchCount} municípios do GeoJSON sem correspondência no banco.`);
    mapaLeaflet.fitBounds(mapaGeoJSON.getBounds());
    setTimeout(()=>mapaLeaflet.invalidateSize(),300);
}

function mapaNormalizarNome(s){
    return(s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toUpperCase().replace(/[^A-Z0-9 ]/g,' ').replace(/\s+/g,' ').trim();
}

