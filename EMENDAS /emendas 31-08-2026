function mkPag(id,cur,tot,goFn,ppVar,ppChangeFn){
    const el=document.getElementById(id);
    const ppVal=window[ppVar]||25;
    let h=`<div class="flex items-center gap-2 flex-wrap justify-center w-full">`;
    // Per page selector
    h+=`<div class="flex items-center gap-1 text-sm text-gray-500 mr-2"><span>Exibir</span><select class="form-input py-1 px-2 text-sm w-auto" style="min-width:70px" onchange="${ppChangeFn}(this.value)">`;
    [25,50,100,500].forEach(n=>h+=`<option value="${n}"${ppVal===n?' selected':''}>${n}</option>`);
    h+=`</select></div>`;
    // Page buttons
    if(tot>1){
        h+=`<button class="pag-btn" onclick="${goFn}(${cur-1})"${cur<=1?' disabled':''}><i class="fas fa-chevron-left"></i></button>`;
        const s=Math.max(1,cur-2),e=Math.min(tot,cur+2);
        if(s>1)h+=`<button class="pag-btn" onclick="${goFn}(1)">1</button>`+(s>2?'<span class="px-1 text-gray-400">…</span>':'');
        for(let i=s;i<=e;i++)h+=`<button class="pag-btn${i===cur?' active':''}" onclick="${goFn}(${i})">${i}</button>`;
        if(e<tot)h+=(e<tot-1?'<span class="px-1 text-gray-400">…</span>':'')+`<button class="pag-btn" onclick="${goFn}(${tot})">${tot}</button>`;
        h+=`<button class="pag-btn" onclick="${goFn}(${cur+1})"${cur>=tot?' disabled':''}><i class="fas fa-chevron-right"></i></button>`;
    }
    h+=`</div>`;
    el.innerHTML=h;
}
