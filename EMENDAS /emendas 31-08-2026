// ARQUIVOS DA EMENDA — Upload, Listagem e Download
// ------------------------------------------------------------
// Modal acionado pelo botao de pasta na lista de Emendas. Permite
// enviar 1..N arquivos (drag-and-drop ou clique), listar os ja
// enviados e baixar/excluir cada um. Os arquivos sao gravados
// em /uploads/emendas/{id}/ e protegidos por .htaccess —
// download e SEMPRE feito atraves de api/arquivos_emenda.php.
// ============================================================
let _arqEmendaIdAtual = 0;

function abrirArquivosEmenda(id){
    _arqEmendaIdAtual = id;
    document.getElementById('arqEmendaIdLbl').textContent = '#' + id;
    document.getElementById('arqList').innerHTML = '<div class="text-center py-6 text-gray-400 text-sm"><div class="spinner mb-2"></div>Carregando...</div>';
    document.getElementById('arqInput').value = '';
    document.getElementById('arqProgress').classList.remove('show');
    document.getElementById('arqProgressBar').style.width = '0%';
    document.getElementById('modalArquivosEmenda').classList.add('show');
    carregarArquivosEmenda();
    montarDragDropArquivos();
}

async function carregarArquivosEmenda(){
    if(!_arqEmendaIdAtual) return;
    const r = await api('arquivos_emenda.php?emenda_id=' + _arqEmendaIdAtual);
    const list = document.getElementById('arqList');
    if(!r || r.error){
        list.innerHTML = '<div class="text-center py-6 text-red-500 text-sm">'+(r&&r.error?r.error:'Erro ao carregar')+'</div>';
        return;
    }
    const data = r.data || [];
    if(!data.length){ list.innerHTML = ''; return; }
    list.innerHTML = data.map(a => {
        const ico = iconePorMime(a.mime_type, a.nome_original);
        const tam = formatarBytes(parseInt(a.tamanho||0));
        const dt  = a.criado_em ? new Date(a.criado_em.replace(' ','T')).toLocaleString('pt-BR') : '';
        const aut = a.user_nome ? ' &middot; '+escapeHtmlSimple(a.user_nome) : '';
        return `<div class="arq-item">
            <div class="arq-ico"><i class="fas ${ico}"></i></div>
            <div class="arq-info">
                <div class="arq-nome" title="${escapeHtmlSimple(a.nome_original)}">${escapeHtmlSimple(a.nome_original)}</div>
                <div class="arq-meta">${tam} &middot; ${dt}${aut}</div>
            </div>
            <div class="arq-acts">
                <button class="action-btn action-btn-edit" title="Baixar" onclick="baixarArquivoEmenda(${a.id})"><i class="fas fa-download"></i></button>
                <button class="action-btn action-btn-del" title="Excluir" onclick="excluirArquivoEmenda(${a.id})"><i class="fas fa-trash"></i></button>
            </div>
        </div>`;
    }).join('');
}

function escapeHtmlSimple(s){
    return String(s||'').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

function iconePorMime(mime, nome){
    mime = (mime||'').toLowerCase();
    const ext = (nome||'').split('.').pop().toLowerCase();
    if(mime.startsWith('image/')) return 'fa-file-image';
    if(mime.startsWith('video/')) return 'fa-file-video';
    if(mime.startsWith('audio/')) return 'fa-file-audio';
    if(mime==='application/pdf' || ext==='pdf') return 'fa-file-pdf';
    if(['doc','docx','odt','rtf'].includes(ext)) return 'fa-file-word';
    if(['xls','xlsx','csv','ods'].includes(ext)) return 'fa-file-excel';
    if(['ppt','pptx','odp'].includes(ext)) return 'fa-file-powerpoint';
    if(['zip','rar','7z'].includes(ext)) return 'fa-file-archive';
    if(['txt'].includes(ext)) return 'fa-file-lines';
    return 'fa-file';
}

function formatarBytes(b){
    if(!b||isNaN(b)) return '0 B';
    const u=['B','KB','MB','GB']; let i=0; while(b>=1024 && i<u.length-1){b/=1024;i++;}
    return (b<10 && i>0 ? b.toFixed(1) : Math.round(b)) + ' ' + u[i];
}

function montarDragDropArquivos(){
    const drop = document.getElementById('arqDrop');
    if(!drop || drop.dataset.bound) return;
    drop.dataset.bound = '1';
    ['dragenter','dragover'].forEach(ev=>drop.addEventListener(ev, e=>{e.preventDefault();e.stopPropagation();drop.classList.add('dragover');}));
    ['dragleave','drop'].forEach(ev=>drop.addEventListener(ev, e=>{e.preventDefault();e.stopPropagation();drop.classList.remove('dragover');}));
    drop.addEventListener('drop', e=>{ if(e.dataTransfer && e.dataTransfer.files) enviarArquivosEmenda(e.dataTransfer.files); });
}

function enviarArquivosEmenda(fileList){
    if(!_arqEmendaIdAtual) return;
    if(!fileList || !fileList.length) return;
    const fd = new FormData();
    fd.append('emenda_id', _arqEmendaIdAtual);
    for(const f of fileList){ fd.append('arquivo[]', f, f.name); }

    const bar  = document.getElementById('arqProgressBar');
    const wrap = document.getElementById('arqProgress');
    wrap.classList.add('show'); bar.style.width = '0%';

    const xhr = new XMLHttpRequest();
    xhr.open('POST', 'api/arquivos_emenda.php');
    xhr.upload.onprogress = ev => {
        if(ev.lengthComputable){
            bar.style.width = Math.round((ev.loaded/ev.total)*100) + '%';
        }
    };
    xhr.onload = () => {
        wrap.classList.remove('show'); bar.style.width = '0%';
        document.getElementById('arqInput').value = '';
        let r = {};
        try { r = JSON.parse(xhr.responseText || '{}'); } catch(_){}
        if(xhr.status >= 200 && xhr.status < 300 && r.success){
            const n = (r.enviados||[]).length;
            toast(n + (n===1?' arquivo enviado.':' arquivos enviados.'));
            if((r.erros||[]).length) toast(r.erros.join(' | '), 5000);
        } else {
            toast((r && r.error) ? r.error : 'Falha no envio', 4000);
        }
        carregarArquivosEmenda();
        // Atualiza a lista de emendas / relatorios para refletir o destaque verde
        if(typeof carregarEmendas === 'function' && document.getElementById('page-emendas')?.classList.contains('active')) carregarEmendas();
        if(typeof gerarRelatorio === 'function' && document.getElementById('page-relatorios')?.classList.contains('active')) gerarRelatorio(true);
    };
    xhr.onerror = () => {
        wrap.classList.remove('show');
        toast('Erro de rede ao enviar arquivos', 4000);
    };
    xhr.send(fd);
}

