    const t={dashboard:'Painel Geral',emendas:'Emendas',relatorios:'Relatórios',mapa:'Mapa Interativo','cad-municipios':'Municípios','cad-associacoes':'Associações','cad-modalidades':'Modalidades','cad-regioes':'Coordenações','cad-status':'Status','cad-cargos':'Cargos','cad-interessados':'Interessados','cad-funcoes':'Funções','cad-usuarios':'Usuários',ia:'Destinação IA',logs:'Logs de Auditoria'};
