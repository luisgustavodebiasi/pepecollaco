// Constrói o "blob" textual de uma emenda — usado pela busca dinâmica.
// Inclui hierarquia (município/associação/coordenação), cargo do interessado,
// objeto/observações (onde costumam ficar ruas, bairros, endereços),
// SGPE, número, forma transferência, datas (ISO + dd/mm/aaaa) e valor (várias formas).
function buildEmendaSearchBlob(e){
    const ints = cacheSelects['interessados']||[];
    const cargos = cacheSelects['cargos']||[];
    let cargoNome = e.cargo_nome || '';
    if(!cargoNome && e.interessado_id){
        const it = ints.find(i=>String(i.id)===String(e.interessado_id));
        if(it){
            cargoNome = it.cargo_nome || '';
            if(!cargoNome && it.cargo_id){
                const cg = cargos.find(c=>String(c.id)===String(it.cargo_id));
                if(cg) cargoNome = cg.nome||'';
            }
        }
    }
    const fmtDateBR = iso => {
        if(!iso) return '';
        const m = String(iso).match(/^(\d{4})-(\d{2})-(\d{2})/);
        return m ? `${m[3]}/${m[2]}/${m[1]}` : '';
    };
    const valNum = parseFloat(e.valor||0);
    const valFmt = fmtV(e.valor);                     // R$ 1.234,56
    const valRaw = String(e.valor||'');               // 1234.56
    const valBR  = isNaN(valNum) ? '' : valNum.toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2}); // 1.234,56
    const valInt = isNaN(valNum) ? '' : String(Math.round(valNum)); // 1235
    const partes = [
        e.regiao_nome, e.associacao_nome, e.municipio_nome,
        e.interessado_nome, e.interessado, cargoNome,
        e.objeto, htmlToText(e.observacoes), e.obs_data_publicacao,
        e.modalidade_nome, e.status_nome,
        e.sgpe, e.numero_emenda, e.forma_transferencia,
        e.data_publicacao, e.data_pgto_troca,
        fmtDateBR(e.data_publicacao), fmtDateBR(e.data_pgto_troca),
        valFmt, valRaw, valBR, valInt
    ];
    return partes.filter(Boolean).join(' \u0001 ').toUpperCase();
}

function relBuscaDinamicaApply(){
    const raw=(document.getElementById('relBuscaDinamica')?.value||'').toUpperCase().trim();
    if(!raw){
        rData=[...rDataAll];
    } else {
        // Suporta várias palavras: todas devem aparecer (em qualquer campo)
        const termos = raw.split(/\s+/).filter(Boolean);
        rData=rDataAll.filter(e=>{
            const blob = buildEmendaSearchBlob(e);
            return termos.every(t=>blob.includes(t));
        });
    }
    const totalValor=rData.reduce((a,e)=>a+parseFloat(e.valor||0),0);
    document.getElementById('relTotal').textContent=`(${rData.length} registros)`;
    document.getElementById('relSoma').textContent='Total: '+fmtV(totalValor);
    renderRTable();
}
