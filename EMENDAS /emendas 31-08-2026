        if(el) el.textContent=allChecked?'Remover tudo':'Marcar tudo';
    });
    // Section toggles
    const sections=new Set();
    document.querySelectorAll('.perm-cb[data-section]').forEach(cb=>sections.add(cb.dataset.section));
    sections.forEach(sec=>{
        ['consultar','editar','excluir'].forEach(perm=>{
            const cbs=document.querySelectorAll(`.perm-cb[data-section="${sec}"][data-perm="${perm}"]`);
            const allChecked=[...cbs].every(cb=>cb.checked);
            const el=document.getElementById(`toggleSec_${sec}_${perm}`);
            if(el) el.textContent=allChecked?'Nenhum':'Tudo';
        });
    });
}

