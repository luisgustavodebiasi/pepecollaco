    const menus=new Set();
    document.querySelectorAll('.perm-cb').forEach(cb=>{
        menus.add(cb.dataset.menu);
    });
    menus.forEach(menuKey=>{
        const c=document.querySelector(`.perm-cb[data-menu="${menuKey}"][data-perm="consultar"]`)?.checked?1:0;
        const e=document.querySelector(`.perm-cb[data-menu="${menuKey}"][data-perm="editar"]`)?.checked?1:0;
        const x=document.querySelector(`.perm-cb[data-menu="${menuKey}"][data-perm="excluir"]`)?.checked?1:0;
        if(c||e||x) perms.push({menu_key:menuKey,pode_consultar:c,pode_editar:e,pode_excluir:x});
    });
    return perms;
}

