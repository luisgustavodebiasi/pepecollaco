// Registrar Service Worker para PWA
if ('serviceWorker' in navigator) {
    // FIX: Landscape responsiveness - force remove max-height on orientation change
    function fixLandscapeTables(){
        const isLandscape = window.innerHeight < 500 || (window.innerWidth > window.innerHeight && window.innerWidth <= 1024);
        document.querySelectorAll('.table-responsive').forEach(el=>{
            if(isLandscape){
                el.style.maxHeight='none';
            } else {
                // Restore original max-height if stored, or leave as is
                if(el.dataset.origMaxHeight) el.style.maxHeight=el.dataset.origMaxHeight;
            }
        });
    }
    // Store original max-heights
    document.querySelectorAll('.table-responsive[style*="max-height"]').forEach(el=>{
        el.dataset.origMaxHeight=el.style.maxHeight;
    });
    window.addEventListener('resize', fixLandscapeTables);
    window.addEventListener('orientationchange', ()=>setTimeout(fixLandscapeTables,200));
    fixLandscapeTables();
    // Also fix dynamically created tables
    new MutationObserver(()=>{
        document.querySelectorAll('.table-responsive[style*="max-height"]:not([data-orig-stored])').forEach(el=>{
            el.dataset.origMaxHeight=el.style.maxHeight;
            el.dataset.origStored='1';
        });
        fixLandscapeTables();
    }).observe(document.body,{childList:true,subtree:true});

    window.addEventListener('load', () => {
        // updateViaCache:'none' = navegador NUNCA usa cache HTTP para buscar sw.js
        navigator.serviceWorker.register('sw.js?v=' + Date.now(), { updateViaCache: 'none' }).then(reg => {
            console.log('SW registrado:', reg.scope);
            // Força verificação de atualização a cada carregamento
            reg.update();
            // Verifica atualizações periodicamente (a cada 30 min)
            setInterval(() => reg.update(), 30 * 60 * 1000);
            // Quando detectar nova versão, recarrega
            reg.addEventListener('updatefound', () => {
                const sw = reg.installing;
                if(!sw) return;
                sw.addEventListener('statechange', () => {
                    if(sw.state === 'installed' && navigator.serviceWorker.controller){
                        console.log('Nova versão do SW disponível');
                    }
                });
            });
        }).catch(err => {
            console.log('SW falhou:', err);
        });
    });
}

