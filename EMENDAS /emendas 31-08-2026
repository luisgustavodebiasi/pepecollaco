async function carregarLogs(){
    let url=`audit.php?action=listar&page=${logPage}&per_page=${logPerPage}`;
    const usuario=document.getElementById('logFlUsuario')?.value;
    const acao=document.getElementById('logFlAcao')?.value;
    const di=document.getElementById('logFlDataIni')?.value;
    const df=document.getElementById('logFlDataFim')?.value;
    const busca=document.getElementById('logFlBusca')?.value;
    if(usuario)url+=`&usuario_id=${usuario}`;
    if(acao)url+=`&acao=${encodeURIComponent(acao)}`;
    if(di)url+=`&data_inicio=${di}`;
    if(df)url+=`&data_fim=${df}`;
    if(busca)url+=`&busca=${encodeURIComponent(busca)}`;

    try{
        const r=await api(url);
        logData=r.data||[];
        logTotal=r.total||0;
        logPages=r.pages||1;
    }catch(e){logData=[];logTotal=0;logPages=1;}

    const info=document.getElementById('logInfo');
    if(info) info.textContent=`${logTotal} registro${logTotal!==1?'s':''}`;

    const tbody=document.getElementById('logTableBody');
    if(!tbody)return;

    if(logData.length===0){
        tbody.innerHTML='<tr><td colspan="6" class="text-center py-4 text-gray-400">Nenhum registro encontrado</td></tr>';
    } else {
        tbody.innerHTML=logData.map(l=>{
            const ac=ACAO_LABELS[l.acao]||{label:l.acao,icon:'fa-circle',bg:'#f1f5f9',color:'#475569'};
            const dt=new Date(l.criado_em);
            const dtStr=dt.toLocaleDateString('pt-BR')+' '+dt.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
            return`<tr>
                <td class="text-xs text-gray-500 whitespace-nowrap">${dtStr}</td>
                <td class="font-medium text-sm">${l.usuario_nome||'<span class="text-gray-300">Sistema</span>'}</td>
                <td><span class="badge" style="background:${ac.bg};color:${ac.color};"><i class="fas ${ac.icon} mr-1"></i>${ac.label}</span></td>
                <td class="text-sm text-gray-600">${l.modulo||'—'}</td>
                <td class="text-sm" style="max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="${(l.descricao||'').replace(/"/g,'&quot;')}">${l.descricao||'—'}</td>
                <td class="text-xs text-gray-400 font-mono">${l.ip||'—'}</td>
            </tr>`;
        }).join('');
    }

    // Paginação
    const pagEl=document.getElementById('pagLogs');
    if(!pagEl)return;
    if(logPages<=1){pagEl.innerHTML='';return;}
    let ph=`<div class="flex items-center gap-2 flex-wrap justify-center w-full">`;
    ph+=`<div class="flex items-center gap-1 text-sm text-gray-500 mr-2"><span>Exibir</span><select class="form-input py-1 px-2 text-sm w-auto" style="min-width:70px" onchange="logPerPage=parseInt(this.value);logPage=1;carregarLogs()">`;
    [25,50,100].forEach(n=>ph+=`<option value="${n}"${logPerPage===n?' selected':''}>${n}</option>`);
    ph+=`</select></div>`;
    ph+=`<button class="pag-btn" onclick="logPage=${logPage-1};carregarLogs()"${logPage<=1?' disabled':''}><i class="fas fa-chevron-left"></i></button>`;
    const ls=Math.max(1,logPage-2),le=Math.min(logPages,logPage+2);
    if(ls>1)ph+=`<button class="pag-btn" onclick="logPage=1;carregarLogs()">1</button>`+(ls>2?'<span class="px-1 text-gray-400">…</span>':'');
    for(let i=ls;i<=le;i++)ph+=`<button class="pag-btn${i===logPage?' active':''}" onclick="logPage=${i};carregarLogs()">${i}</button>`;
    if(le<logPages)ph+=(le<logPages-1?'<span class="px-1 text-gray-400">…</span>':'')+`<button class="pag-btn" onclick="logPage=${logPages};carregarLogs()">${logPages}</button>`;
    ph+=`<button class="pag-btn" onclick="logPage=${logPage+1};carregarLogs()"${logPage>=logPages?' disabled':''}><i class="fas fa-chevron-right"></i></button>`;
    ph+=`</div>`;
    pagEl.innerHTML=ph;
}

