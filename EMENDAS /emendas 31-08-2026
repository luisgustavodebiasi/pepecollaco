};

async function mapaClicarGrupo(grupoId, tipo){
    const lista=tipo==='associacao'?mapaDadosAssociacoes:mapaDadosRegioes;
    const grupo=lista.find(g=>parseInt(g.id)===grupoId);
    if(!grupo)return;
    mapaGrupoAtual=grupo.nome;
    if(mapaLeaflet.hasLayer(mapaRotulosTodos)) mapaLeaflet.removeLayer(mapaRotulosTodos);
    const itens=mapaCamadasPorGrupo[grupo.nome];
    if(itens&&itens.length>0){
        const poligonos=itens.map(i=>i.poligono);
        const gr=new L.featureGroup(poligonos);
        mapaLeaflet.fitBounds(gr.getBounds(),{padding:[30,30],maxZoom:10});
        mapaRotulos.clearLayers();
        itens.forEach(item=>{
            const centro=item.poligono.getBounds().getCenter();
            mapaRotulos.addLayer(L.marker(centro,{
                icon:L.divIcon({className:'rotulo-cidade',html:item.nome,iconSize:null}),
                interactive:false
            }));
        });
        document.getElementById('mapaBtnVoltar').classList.add('show');
    }
    try{
        if(tipo==='associacao'){
            const dados=await api('mapa.php?action=resumo_associacao&associacao_id='+grupoId);
            mostrarPainelGrupo(dados,grupo,'associacao');
        }else{
            const dados=await api('mapa.php?action=resumo_regiao&regiao_id='+grupoId);
            mostrarPainelGrupo(dados,grupo,'coordenacao');
        }
    }catch(e){console.error(e);}
}

