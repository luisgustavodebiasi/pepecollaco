// SHARED TABLE
const COLS=[{k:'regiao_nome',l:'Coord.',s:1},{k:'associacao_nome',l:'Associação',s:1},{k:'municipio_nome',l:'Município',s:1},{k:'interessado',l:'Interessado',s:1},{k:'valor',l:'Valor',s:1},{k:'objeto',l:'Objeto',s:0},{k:'modalidade_nome',l:'Modalidade',s:1},{k:'status_nome',l:'Status',s:1}];

function mkThead(id,sc,sd,fn){
    document.getElementById(id).innerHTML='<tr>'+COLS.map(c=>{
        let cls=c.s?'sortable':'';if(c.s&&c.k===sc)cls+=' sort-'+(sd==='asc'?'asc':'desc');
        const oc=c.s?` onclick="${fn}('${c.k}')"`:''
        return`<th class="${cls}"${oc}>${c.l} <span class="sort-icon"></span></th>`;
    }).join('')+'<th class="text-center" style="min-width:200px">Ações</th></tr>';
}
function mkRows(data,id,clickFn){
    document.getElementById(id).invRows=data; // cache para referência rápida do interessado
    document.getElementById(id).innerHTML=data.map(e=>{
        const intNome = e.interessado_nome||e.interessado||'-';
        const intId   = e.interessado_id||0;
        const intCell = intId
            ? `<a href="javascript:void(0)" class="int-link" onclick="event.stopPropagation();verInteressadoDetalhes(${intId})" title="Ver detalhes do interessado">${intNome}</a>`
            : intNome;
        // Destaque verde para emendas com anexo (e.tem_arquivos vem do SELECT em Emenda::listar).
        const nArq = parseInt(e.tem_arquivos||0);
        const rowCls = nArq > 0 ? 'clickable-row row-anexo' : 'clickable-row';
        const arqBadge = nArq > 0
            ? `<span class="anexo-badge" title="${nArq} arquivo(s) anexado(s)"><i class="fas fa-paperclip"></i> ${nArq}</span>`
            : '';
        const folderIcon = nArq > 0 ? 'fa-folder' : 'fa-folder-open';
        return `
        <tr class="${rowCls}" onclick="${clickFn}(${e.id})">
            <td>${e.regiao_nome||'-'}</td>
            <td>${e.associacao_nome||'-'}</td>
            <td class="font-medium">${e.municipio_nome||'-'}</td>
            <td>${intCell}</td>
            <td class="font-semibold text-green-700 whitespace-nowrap">${fmtV(e.valor)}</td>
            <td class="obj-cell" title="${(e.objeto||'').replace(/"/g,'&quot;')}">${e.objeto||'-'}${arqBadge}</td>
            <td class="whitespace-nowrap">${e.modalidade_nome||'-'}</td>
            <td>${statusBadge(e.status_nome)}</td>
            <td class="text-center" onclick="event.stopPropagation()">
                <div class="action-btns">
