async function addCad(tab){
    const inp=document.getElementById('newCad-'+tab), n=inp.value.trim();
    if(!n) return toast('Nome é obrigatório');
    const body={nome:n};
    if(tab==='municipios'){
        const ibge=document.getElementById('newCadIbge-'+tab);
        if(ibge) body.ibge_code=ibge.value.trim();
        const assocSel=document.getElementById('newCadAssoc-'+tab);
        if(assocSel&&assocSel.value) body.associacao_id=assocSel.value;
    }
    if(tab==='associacoes'){
        const cor=document.getElementById('newCadCor-'+tab);
        if(cor) body.cor_hex=cor.value;
        const regSel=document.getElementById('newCadRegiao-'+tab);
        if(regSel&&regSel.value) body.regiao_id=regSel.value;
    }
    if(tab==='regioes'){
        const cor=document.getElementById('newCadCor-'+tab);
        if(cor) body.cor_hex=cor.value;
    }
    if(tab==='status_emendas'){
        const cor=document.getElementById('newCadCor-'+tab);
        if(cor) body.cor_hex=cor.value;
    }
    const r=await api('cadastros.php?tabela='+tab,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
    if(r.success){
        toast('Cadastrado!');inp.value='';
        const ibge=document.getElementById('newCadIbge-'+tab);if(ibge)ibge.value='';
        const assocSel=document.getElementById('newCadAssoc-'+tab);if(assocSel)assocSel.value='';
        const regSel=document.getElementById('newCadRegiao-'+tab);if(regSel)regSel.value='';
        const cor=document.getElementById('newCadCor-'+tab);if(cor)cor.value='#3b82f6';
        const assocInfo=document.getElementById('newCadAssocInfo-'+tab);if(assocInfo)assocInfo.style.display='none';
        const regInfo=document.getElementById('newCadRegiaoInfo-'+tab);if(regInfo)regInfo.style.display='none';
        await loadSelects();renderCad(currentPage);
    }
    else toast(r.error,4000);
}

function editCad(tab,id){
    const items=cacheSelects[tab]||[];
    const item=items.find(i=>i.id==id);
    if(!item) return;
    document.getElementById('cadEditId').value=id;
    document.getElementById('cadEditTabela').value=tab;
    document.getElementById('cadEditNome').value=item.nome;
    // IBGE
    const ibgeW=document.getElementById('cadEditIbgeWrap');
    ibgeW.style.display=tab==='municipios'?'block':'none';
    if(tab==='municipios') document.getElementById('cadEditIbge').value=item.ibge_code||'';
    // Associação (para municípios)
    const assocW=document.getElementById('cadEditAssocWrap');
    const assocInfoW=document.getElementById('cadEditAssocInfoWrap');
    assocW.style.display=tab==='municipios'?'block':'none';
    assocInfoW.style.display=tab==='municipios'?'block':'none';
    if(tab==='municipios'){
        popSel('cadEditAssoc','associacoes',item.associacao_id);
        cadEditAssocChanged();
    }
    // Coordenação (para associações)
    const regW=document.getElementById('cadEditRegiaoWrap');
    const regInfoW=document.getElementById('cadEditRegiaoInfoWrap');
    regW.style.display=tab==='associacoes'?'block':'none';
    regInfoW.style.display=tab==='associacoes'?'block':'none';
    if(tab==='associacoes'){
        popSel('cadEditRegiao','regioes',item.regiao_id);
        cadEditRegiaoChanged();
    }
    // Cor
    const corW=document.getElementById('cadEditCorWrap');
    const hasColor=tab==='regioes'||tab==='associacoes'||tab==='status_emendas';
    corW.style.display=hasColor?'block':'none';
    if(hasColor){
        document.getElementById('cadEditCor').value=item.cor_hex||'#cccccc';
        document.getElementById('cadEditCorHex').value=item.cor_hex||'';
    }
    const labels={'municipios':'Município','regioes':'Coordenação','associacoes':'Associação','modalidades':'Modalidade','status_emendas':'Status','cargos':'Cargo'};
    document.getElementById('modalCadTitle').textContent='Editar '+labels[tab]+' #'+id;
    document.getElementById('modalCad').classList.add('show');
}

async function salvarCadEditar(ev){
    ev.preventDefault();
    const tab=document.getElementById('cadEditTabela').value;
    const id=document.getElementById('cadEditId').value;
    const nome=document.getElementById('cadEditNome').value.trim();
    if(!nome) return toast('Nome é obrigatório');
    const body={id:parseInt(id),nome};
    if(tab==='municipios'){
        body.ibge_code=document.getElementById('cadEditIbge').value.trim();
        body.associacao_id=document.getElementById('cadEditAssoc').value||null;
    }
    if(tab==='associacoes'){
        body.cor_hex=document.getElementById('cadEditCorHex').value||document.getElementById('cadEditCor').value;
        body.regiao_id=document.getElementById('cadEditRegiao').value||null;
    }
    if(tab==='regioes'){
        body.cor_hex=document.getElementById('cadEditCorHex').value||document.getElementById('cadEditCor').value;
    }
    if(tab==='status_emendas'){
        body.cor_hex=document.getElementById('cadEditCorHex').value||document.getElementById('cadEditCor').value;
    }
    const r=await api('cadastros.php?tabela='+tab,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
    if(r.success){toast('Atualizado!');fecharModal('modalCad');await loadSelects();renderCad(currentPage);}
    else toast(r.error,4000);
}

async function delCad(tab,id){if(!confirm('Excluir este registro?'))return;const r=await api('cadastros.php?tabela='+tab+'&id='+id,{method:'DELETE'});if(r.success){toast('Excluído');await loadSelects();if(currentPage==='cad-interessados')renderInteressados();else renderCad(currentPage);}else toast(r.error,4000);}

// Color info helpers for Associação → Coordenação
function buildAssocColorHtml(assocId){
    const assocs=cacheSelects['associacoes']||[];
    const assoc=assocs.find(a=>a.id==assocId);
    if(!assoc) return '<span class="text-gray-400">—</span>';
    const regioes=cacheSelects['regioes']||[];
    const regiao=assoc.regiao_id?regioes.find(r=>r.id==assoc.regiao_id):null;
    let html=`<span class="cad-color-swatch" style="background:${assoc.cor_hex||'#ccc'};width:18px;height:18px;"></span><span class="font-semibold" style="color:${assoc.cor_hex||'#475569'}">${assoc.nome}</span>`;
    if(regiao) html+=`<span class="text-gray-300 mx-1">|</span><span class="cad-color-swatch" style="background:${regiao.cor_hex||'#ccc'};width:18px;height:18px;"></span><span class="font-semibold" style="color:${regiao.cor_hex||'#475569'}">${regiao.nome}</span>`;
    return html;
}
function cadAddAssocChanged(tab){
    const sel=document.getElementById('newCadAssoc-'+tab);
    const infoWrap=document.getElementById('newCadAssocInfo-'+tab);
    const infoEl=document.getElementById('newCadAssocInfoDisplay-'+tab);
    if(!sel||!infoWrap||!infoEl)return;
    if(!sel.value){infoWrap.style.display='none';return;}
    infoWrap.style.display='block';
    infoEl.innerHTML=buildAssocColorHtml(parseInt(sel.value));
