// ============================================================
let userPermissoes=null, isAdminLegado=false;

async function carregarPermissoes(){
    try{
        const r=await fetch(API+'usuarios.php?entity=minha_permissao');
        const data=await r.json();
        if(data.admin_legado){
            isAdminLegado=true;
            userPermissoes=null;
        } else {
            isAdminLegado=false;
            userPermissoes={};
            (data.permissoes||[]).forEach(p=>{
                userPermissoes[p.menu_key]={consultar:+p.pode_consultar,editar:+p.pode_editar,excluir:+p.pode_excluir};
            });
        }
        aplicarPermissoes();
    }catch(e){
        // Fallback: acesso total
        isAdminLegado=true;
        userPermissoes=null;
    }
}

function temPermissao(menuKey,acao){
    if(isAdminLegado)return true;
    if(!userPermissoes)return true;
    const p=userPermissoes[menuKey];
    if(!p)return false;
    if(acao==='consultar')return !!p.consultar;
    if(acao==='editar')return !!p.editar;
    if(acao==='excluir')return !!p.excluir;
    return false;
}

function temAcessoMenu(menuKey){
    if(isAdminLegado)return true;
    if(!userPermissoes)return true;
    const p=userPermissoes[menuKey];
    return !!(p&&(p.consultar||p.editar||p.excluir));
}

function aplicarPermissoes(){
    // Ocultar menus que o usuário não tem acesso
    document.querySelectorAll('.nav-item[data-page]').forEach(el=>{
        const page=el.dataset.page;
        if(!page)return;
        // Menus perm-menu (funções/usuarios) são controlados separadamente
        if(temAcessoMenu(page)){
            el.style.display='';
        } else {
            el.style.display='none';
        }
    });
}

