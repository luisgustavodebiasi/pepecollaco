// ============================================================
// Mini editor rich-text (campo Observações da Emenda)
// ------------------------------------------------------------
// Implementacao leve com contenteditable + execCommand. Salva
// somente HTML SANITIZADO (apenas <b>/<strong>/<i>/<em>/<u>/<br>),
// mantendo o restante como texto puro. Suporta atalhos
// Ctrl+B / Ctrl+I / Ctrl+U e uma toolbar com botoes.
// ============================================================
function rtCmd(ev, id, cmd){
    if(ev) ev.preventDefault();
    const el = document.getElementById(id);
    if(!el) return;
    el.focus();
    try { document.execCommand(cmd, false, null); } catch(_) {}
    rtUpdateToolbar(id);
}
function rtKey(ev, id){
    // Atalhos Ctrl/Cmd + B/I/U (execCommand ja faz isso, mas garantimos a sincronizacao)
    if((ev.ctrlKey||ev.metaKey) && !ev.altKey && !ev.shiftKey){
        const k = ev.key.toLowerCase();
        if(k==='b' || k==='i' || k==='u'){ setTimeout(()=>rtUpdateToolbar(id), 0); }
    }
}
function rtSync(id){ rtUpdateToolbar(id); }
// Limpa o paste do usuario antes de inserir no editor — assim trechos vindos
// do Word, Google Docs ou paginas web nao trazem cores, fontes e divs estranhos.
function rtPaste(ev, id){
    ev.preventDefault();
    const cd = ev.clipboardData || window.clipboardData;
    if(!cd) return;
    let html = cd.getData('text/html');
    let text = cd.getData('text/plain');
    let toInsert = '';
    if(html){
        toInsert = sanitizeRichText(html);
    } else if(text){
        // Texto puro: escapa e converte quebras em <br>
        toInsert = String(text)
            .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
            .replace(/\r\n|\r|\n/g, '<br>');
    }
    if(!toInsert) return;
    // Insere preservando a posicao do cursor
    if(document.queryCommandSupported && document.queryCommandSupported('insertHTML')){
        document.execCommand('insertHTML', false, toInsert);
    } else {
        // Fallback: append no final
        document.getElementById(id).innerHTML += toInsert;
    }
    rtUpdateToolbar(id);
}
function rtUpdateToolbar(id){
    const el = document.getElementById(id);
    if(!el) return;
    const tb = el.previousElementSibling;
    if(!tb || !tb.classList.contains('rt-toolbar')) return;
    tb.querySelectorAll('.rt-btn[data-cmd]').forEach(btn => {
        const cmd = btn.getAttribute('data-cmd');
        let on = false;
        try { on = document.queryCommandState(cmd); } catch(_){}
        btn.classList.toggle('active', on);
    });
}
function rtSetHtml(id, html){
    const el = document.getElementById(id);
    if(!el) return;
    el.innerHTML = sanitizeRichText(html||'');
}
function rtGetHtml(id){
    const el = document.getElementById(id);
    if(!el) return '';
    // Sanitiza ao salvar para garantir que so tags permitidas chegam ao banco
    return sanitizeRichText(el.innerHTML||'').trim();
}
// Renderiza um valor armazenado no campo `observacoes` como HTML seguro
// (apenas <b>/<strong>/<i>/<em>/<u>/<br>). Use sempre que for jogar o
// conteudo dentro de innerHTML/title/cell — assim o usuario VE o negrito,
// nao a tag crua.
function rtRender(html){
    return sanitizeRichText(html||'');
}
// Remove TODAS as tags HTML, devolvendo so o texto. Use em buscas,
// tooltips de title="" e qualquer lugar que so aceite plain text.
function htmlToText(html){
    if(!html) return '';
    const tmp = document.createElement('div');
    tmp.innerHTML = sanitizeRichText(String(html));
    return (tmp.textContent || tmp.innerText || '').replace(/\s+/g, ' ').trim();
}
// Permite apenas tags simples de formatacao + <br>; o resto vira texto puro.
// Normaliza diferencas entre navegadores: Chrome/Firefox podem aplicar
// negrito como <span style="font-weight:bold"> e Enter pode virar <div>
// — convertemos para <b>/<br> antes de sanitizar.
function sanitizeRichText(html){
    if(!html) return '';
    const ALLOWED = new Set(['B','STRONG','I','EM','U','BR']);
    const BLOCKS  = new Set(['DIV','P','BLOCKQUOTE','LI','UL','OL','PRE','H1','H2','H3','H4','H5','H6']);
    const tmp = document.createElement('div');
    tmp.innerHTML = String(html);

    // 1) Converte estilos inline em tags semanticas
    tmp.querySelectorAll('[style]').forEach(el => {
        const s = (el.getAttribute('style')||'').toLowerCase();
        const wraps = [];
        if(/font-weight\s*:\s*(bold|[7-9]00)/.test(s)) wraps.push('B');
        if(/font-style\s*:\s*italic/.test(s)) wraps.push('I');
        if(/text-decoration\s*:[^;]*underline/.test(s)) wraps.push('U');
        el.removeAttribute('style');
        if(wraps.length){
            const inner = el.innerHTML;
            let h = inner;
            wraps.forEach(t => { h = `<${t.toLowerCase()}>${h}</${t.toLowerCase()}>`; });
            el.innerHTML = h;
        }
    });
    // 2) Substitui <font> por <b> quando aplicavel
    tmp.querySelectorAll('font').forEach(f => {
        const w = (f.getAttribute('weight')||'').toLowerCase();
        if(w === 'bold' || /^[7-9]00$/.test(w)){
            const b = document.createElement('b');
            b.innerHTML = f.innerHTML;
            f.parentNode.replaceChild(b, f);
        } else {
            while(f.firstChild) f.parentNode.insertBefore(f.firstChild, f);
            f.parentNode.removeChild(f);
        }
    });

    const walk = (node) => {
        Array.from(node.childNodes).forEach(child => {
            if(child.nodeType === 1){ // ELEMENT_NODE
                const tag = child.tagName;
                if(BLOCKS.has(tag)){
                    // Bloco: traz conteudo, depois insere <br> para manter a quebra
                    const frag = document.createDocumentFragment();
                    while(child.firstChild) frag.appendChild(child.firstChild);
                    const br = document.createElement('br');
                    node.insertBefore(frag, child);
                    node.insertBefore(br, child);
                    node.removeChild(child);
                    walk(node);
                    return;
                }
                if(!ALLOWED.has(tag)){
                    // Unwrap elementos nao permitidos (preserva texto)
                    while(child.firstChild) node.insertBefore(child.firstChild, child);
                    node.removeChild(child);
                    walk(node);
                    return;
                } else {
                    // Remove qualquer atributo (style/onclick/etc) das tags permitidas
                    Array.from(child.attributes||[]).forEach(a => child.removeAttribute(a.name));
                    walk(child);
                }
            }
        });
    };
    walk(tmp);
    // Limpeza: <br> consecutivos extras / <br> no comeco/fim
    let out = tmp.innerHTML
        .replace(/(<br\s*\/?>\s*){3,}/gi, '<br><br>')
        .replace(/^(\s|<br\s*\/?>)+/i, '')
        .replace(/(\s|<br\s*\/?>)+$/i, '');
    return out;
}

