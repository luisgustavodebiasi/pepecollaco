async function carregarUserLogs(){
    if(!ulUserId)return;
    const di=document.getElementById('ulFlDataIni').value;
    const df=document.getElementById('ulFlDataFim').value;
    const hi=document.getElementById('ulFlHoraIni').value;
    const hf=document.getElementById('ulFlHoraFim').value;
    const acao=document.getElementById('ulFlAcao').value;

    let url=`audit.php?action=listar&page=${ulPage}&per_page=${ulPerPage}&usuario_id=${ulUserId}`;
    if(di){
        const horaIni=hi||'00:00';
        url+=`&data_inicio=${encodeURIComponent(di+' '+horaIni+':00')}`;
    }
    if(df){
        const horaFim=hf||'23:59';
        url+=`&data_fim=${encodeURIComponent(df+' '+horaFim+':59')}`;
    }
    if(acao) url+=`&acao=${encodeURIComponent(acao)}`;

    let data=[], total=0, pages=1;
    try{
        const r=await api(url);
        data=r.data||[];
        total=r.total||0;
        pages=r.pages||1;
    }catch(e){}

    // Resumo
    const resumoEl=document.getElementById('ulResumo');
    // Contar ações
    const counts={};
    // Usaremos o total do servidor, mas para breakdown precisamos dos dados carregados
    // Mostramos o total e info do período
    let periodoTxt='';
    if(di&&df){
        periodoTxt=di===df?`${formatarDataBR(di)}`:`${formatarDataBR(di)} até ${formatarDataBR(df)}`;
        if(hi)periodoTxt+=` das ${hi}`;
        if(hf)periodoTxt+=` até ${hf}`;
    }
    resumoEl.innerHTML=`
        <span class="text-sm font-medium text-gray-600"><i class="fas fa-list mr-1"></i>${total} ${total===1?'ação':'ações'}</span>
        ${periodoTxt?`<span class="text-xs text-gray-400 ml-2">${periodoTxt}</span>`:''}
    `;

    // Tabela
    const tbody=document.getElementById('ulTableBody');
    if(data.length===0){
        tbody.innerHTML='<tr><td colspan="5" class="text-center py-6 text-gray-400"><i class="fas fa-inbox text-2xl mb-2 block"></i>Nenhum registro encontrado</td></tr>';
    } else {
        let lastDate='';
        let rows='';
        data.forEach(l=>{
            const ac=UL_ACAO_LABELS[l.acao]||{label:l.acao,icon:'fa-circle',bg:'#f1f5f9',color:'#475569'};
            const dt=new Date(l.criado_em);
            const dateStr=dt.toLocaleDateString('pt-BR');
            const timeStr=dt.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit',second:'2-digit'});

            // Separador de dia
            if(dateStr!==lastDate){
                lastDate=dateStr;
                rows+=`<tr style="background:#f8fafc;"><td colspan="5" class="py-2 px-3 font-bold text-xs text-gray-500 uppercase tracking-wide"><i class="fas fa-calendar-day mr-1 text-blue-400"></i>${dateStr} — ${diaSemana(dt)}</td></tr>`;
            }

            rows+=`<tr>
                <td class="text-sm whitespace-nowrap"><span class="font-mono text-gray-500">${timeStr}</span></td>
                <td><span class="badge" style="background:${ac.bg};color:${ac.color};font-size:11px;"><i class="fas ${ac.icon} mr-1"></i>${ac.label}</span></td>
                <td class="text-sm text-gray-600">${formatarModulo(l.modulo)}</td>
                <td class="text-sm" style="max-width:320px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="${(l.descricao||'').replace(/"/g,'&quot;')}">${l.descricao||'—'}</td>
                <td class="text-xs text-gray-400 font-mono">${l.ip||'—'}</td>
            </tr>`;
        });
        tbody.innerHTML=rows;
    }

    // Paginação
    const pagEl=document.getElementById('ulPag');
    if(pages<=1){pagEl.innerHTML='';return;}
    let ph=`<div class="flex items-center gap-2 flex-wrap justify-center w-full">`;
    ph+=`<div class="flex items-center gap-1 text-sm text-gray-500 mr-2"><span>Exibir</span><select class="form-input py-1 px-2 text-sm w-auto" style="min-width:70px" onchange="ulPerPage=parseInt(this.value);ulPage=1;carregarUserLogs()">`;
    [25,50,100].forEach(n=>ph+=`<option value="${n}"${ulPerPage===n?' selected':''}>${n}</option>`);
    ph+=`</select></div>`;
