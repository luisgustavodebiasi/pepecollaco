// INTERESSADOS
function intMunChanged(munSelId,assocId,coordId){
    const munVal=document.getElementById(munSelId).value;
    const muns=cacheSelects['municipios']||[];
    const mun=muns.find(m=>m.id==munVal);
    if(mun){
        document.getElementById(assocId).value=mun.associacao_nome||'—';
        const assocs=cacheSelects['associacoes']||[];
        const assoc=assocs.find(a=>a.id==mun.associacao_id);
        document.getElementById(coordId).value=assoc?.regiao_nome||'—';
    } else {
        document.getElementById(assocId).value='';
        document.getElementById(coordId).value='';
    }
}

