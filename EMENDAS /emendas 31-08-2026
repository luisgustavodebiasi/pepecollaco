// HELPERS
let _loadingCount=0;
function showLoading(msg){_loadingCount++;const o=document.getElementById('loadingOverlay'),t=document.getElementById('loadingText');if(msg)t.textContent=msg;else if(_loadingCount===1)t.textContent='Carregando...';o.classList.add('show');}
function hideLoading(){_loadingCount=Math.max(0,_loadingCount-1);if(_loadingCount===0)document.getElementById('loadingOverlay').classList.remove('show');}
async function api(u,o={}){showLoading();try{const r=await(await fetch(API+u,o)).json();hideLoading();return r;}catch(e){hideLoading();throw e;}}
function toast(m,d=3000){const t=document.getElementById('toast');t.textContent=m;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),d);}
function fmtV(v){return parseFloat(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});}
function fecharModal(id){document.getElementById(id).classList.remove('show');}
// Converte cor hex (#rgb / #rrggbb) em rgba com alpha customizado.
// Usado para badges de status com cor de fundo translúcida (70% transparência => alpha 0.3).
function hexToRgba(hex,alpha){
    if(!hex) return 'rgba(203,213,225,'+(alpha??0.3)+')';
    let h=hex.replace('#','').trim();
    if(h.length===3) h=h.split('').map(c=>c+c).join('');
    if(h.length!==6) return 'rgba(203,213,225,'+(alpha??0.3)+')';
    const r=parseInt(h.substring(0,2),16);
    const g=parseInt(h.substring(2,4),16);
    const b=parseInt(h.substring(4,6),16);
    return 'rgba('+r+','+g+','+b+','+(alpha??0.3)+')';
}
function statusBadge(n){
    if(!n) return '<span class="badge badge-default">-</span>';
    // Tenta primeiro a cor cadastrada (cacheSelects['status_emendas'])
    const items=(typeof cacheSelects!=='undefined' && cacheSelects['status_emendas'])||[];
    const match=items.find(s=>(s.nome||'').toUpperCase()===n.toUpperCase());
    if(match && match.cor_hex){
        const bg=hexToRgba(match.cor_hex,0.3);
        const bd=hexToRgba(match.cor_hex,0.6);
        return `<span class="badge" style="background:${bg};color:#1f2937;border:1px solid ${bd};font-weight:600;">${n}</span>`;
    }
    // Fallback para classes legadas (se status sem cor cadastrada)
    const u=n.toUpperCase();let c='badge-default';
    if(u.includes('PAGO'))c=u.includes('PARCIAL')?'badge-verificar':'badge-pago';
    else if(u.includes('PUBLICADO'))c='badge-publicado';
    else if(u.includes('PENDENTE'))c='badge-pendente';
    else if(u.includes('VERIFICAR'))c='badge-verificar';
    return`<span class="badge ${c}">${n}</span>`;
}

// SELECTS
async function loadSelects(){
    showLoading('Carregando dados...');
    try{for(const t of['associacoes','regioes','modalidades','municipios','status_emendas','cargos','interessados'])cacheSelects[t]=await api('cadastros.php?tabela='+t);}
    finally{hideLoading();}
}
function popSel(id,tab,sel){const el=document.getElementById(id);if(!el)return;const items=cacheSelects[tab]||[];const first=el.querySelector('option')?.textContent||'--';el.innerHTML=`<option value="">${first}</option>`+items.map(i=>`<option value="${i.id}"${i.id==sel?' selected':''}>${i.nome}</option>`).join('');}

// ============================================================
// MULTI-SELECT COM CHECKBOXES (filtros Coord./Município)
// ------------------------------------------------------------
// Componente leve baseado em <div role="combobox"> + painel com
// checkboxes. Estado fica guardado em msState[wrapId] como Set
// de IDs (string). Para integrar com a API, use msGetCSV(id).
// ============================================================
const msState = {}; // { wrapId: { sel: Set<string>, items: [{id,nome}], label, onChange } }

function msInit(wrapId, items, label, onChange){
    const wrap = document.getElementById(wrapId);
    if(!wrap) return;
    msState[wrapId] = {
        sel: new Set(),
        items: items || [],
        label: label || 'Selecione',
        onChange: onChange || (()=>{})
    };
    wrap.innerHTML = `
        <button type="button" class="ms-trigger" id="${wrapId}-trigger" onclick="msToggle('${wrapId}', event)">
            <span class="ms-trigger-label placeholder" id="${wrapId}-lbl">Todos</span>
        </button>
        <div class="ms-panel" id="${wrapId}-panel" onclick="event.stopPropagation()">
            <div class="ms-panel-head">
                <input type="text" class="ms-search" placeholder="Buscar..." oninput="msFilter('${wrapId}', this.value)">
                <div class="ms-actions">
                    <button type="button" class="ms-action-btn" onclick="msSelectAll('${wrapId}')">Todos</button>
                    <button type="button" class="ms-action-btn" onclick="msClear('${wrapId}')">Limpar</button>
                </div>
            </div>
            <div class="ms-list" id="${wrapId}-list"></div>
        </div>
    `;
    msRenderList(wrapId);
    msUpdateLabel(wrapId);
}

function msRenderList(wrapId, filter){
    const st = msState[wrapId]; if(!st) return;
    const list = document.getElementById(wrapId+'-list'); if(!list) return;
    const term = (filter||'').toLowerCase().trim();
    const items = term ? st.items.filter(i => (i.nome||'').toLowerCase().includes(term)) : st.items;
    if(!items.length){ list.innerHTML = '<div class="ms-empty">Nenhum resultado</div>'; return; }
    list.innerHTML = items.map(i => {
        const chk = st.sel.has(String(i.id));
        return `<label class="ms-item ${chk?'checked':''}" data-id="${i.id}">
            <input type="checkbox" ${chk?'checked':''} onchange="msToggleItem('${wrapId}','${i.id}', this.checked)">
            <span>${(i.nome||'').replace(/</g,'&lt;')}</span>
        </label>`;
    }).join('');
}

function msToggle(wrapId, ev){
    if(ev) ev.stopPropagation();
    const panel = document.getElementById(wrapId+'-panel');
    const trig  = document.getElementById(wrapId+'-trigger');
    if(!panel || !trig) return;
    // Fecha qualquer outro painel aberto
    document.querySelectorAll('.ms-panel.open').forEach(p => {
        if(p !== panel){ p.classList.remove('open'); p.previousElementSibling?.classList.remove('open'); }
    });
    const willOpen = !panel.classList.contains('open');
    panel.classList.toggle('open', willOpen);
    trig.classList.toggle('open', willOpen);
    if(willOpen){
        msRenderList(wrapId, ''); // limpa filtro ao reabrir
        const s = panel.querySelector('.ms-search'); if(s){ s.value=''; setTimeout(()=>s.focus(), 30); }
    }
}

function msFilter(wrapId, term){ msRenderList(wrapId, term); }

function msToggleItem(wrapId, id, checked){
    const st = msState[wrapId]; if(!st) return;
    const sid = String(id);
    if(checked) st.sel.add(sid); else st.sel.delete(sid);
    // Atualiza visualmente sem re-renderizar a lista inteira (mantem scroll)
    const item = document.querySelector(`#${wrapId}-list .ms-item[data-id="${id}"]`);
    if(item) item.classList.toggle('checked', checked);
    msUpdateLabel(wrapId);
    try { st.onChange(); } catch(e){ console.error(e); }
}

function msSelectAll(wrapId){
    const st = msState[wrapId]; if(!st) return;
    // Considera apenas os itens visiveis pelo filtro atual
    const list = document.getElementById(wrapId+'-list');
    list.querySelectorAll('.ms-item').forEach(it => {
        const id = it.dataset.id; if(id != null) st.sel.add(String(id));
        const cb = it.querySelector('input'); if(cb) cb.checked = true;
        it.classList.add('checked');
    });
    msUpdateLabel(wrapId);
    try { st.onChange(); } catch(e){ console.error(e); }
}

function msClear(wrapId){
    const st = msState[wrapId]; if(!st) return;
    st.sel.clear();
    document.querySelectorAll(`#${wrapId}-list .ms-item`).forEach(it => {
        const cb = it.querySelector('input'); if(cb) cb.checked = false;
        it.classList.remove('checked');
    });
    msUpdateLabel(wrapId);
    try { st.onChange(); } catch(e){ console.error(e); }
}

function msUpdateLabel(wrapId){
    const st = msState[wrapId]; if(!st) return;
    const lbl = document.getElementById(wrapId+'-lbl');
    const trig = document.getElementById(wrapId+'-trigger');
    if(!lbl) return;
    // Limpa badge antigo se houver
    const oldBadge = trig.querySelector('.ms-trigger-count');
    if(oldBadge) oldBadge.remove();
    const n = st.sel.size;
    if(n === 0){
        lbl.textContent = st.label || 'Todos';
        lbl.classList.add('placeholder');
    } else if(n === 1){
        const id = Array.from(st.sel)[0];
        const it = st.items.find(x => String(x.id) === id);
        lbl.textContent = it ? it.nome : '1 selecionado';
        lbl.classList.remove('placeholder');
    } else {
        lbl.textContent = n + ' selecionados';
        lbl.classList.remove('placeholder');
        const badge = document.createElement('span');
        badge.className = 'ms-trigger-count';
        badge.textContent = n;
        trig.appendChild(badge);
    }
}

function msGetCSV(wrapId){
    const st = msState[wrapId]; if(!st) return '';
    return Array.from(st.sel).join(',');
}

function msSetItems(wrapId, items){
    const st = msState[wrapId]; if(!st) return;
    st.items = items || [];
    msRenderList(wrapId);
    msUpdateLabel(wrapId);
}
// Substitui a selecao por uma unica id (usado em deep-links a partir do dashboard).
function msSetSel(wrapId, id){
    const st = msState[wrapId]; if(!st) return;
    st.sel.clear();
    if(id != null && id !== '') st.sel.add(String(id));
    msRenderList(wrapId);
    msUpdateLabel(wrapId);
}
// Verdadeiro se um id corresponde a um wrap multi-select.
const MS_IDS = new Set(['eFlCoord','eFlMun','eFlAssoc','relCoord','relMun','relAssoc']);
// Limpa qualquer filtro (select unico, multi-select ou input).
function flClear(id){
    if(MS_IDS.has(id)){ msClear(id); return; }
    const el = document.getElementById(id);
    if(!el) return;
    if('value' in el) el.value = '';
}
// Define valor de qualquer filtro de modo seguro.
function flSetValue(id, val){
    if(MS_IDS.has(id)){ msSetSel(id, val); return; }
    const el = document.getElementById(id);
    if(!el) return;
    if('value' in el) el.value = val;
}
// Devolve a string legivel de um filtro (para exibicao em "Filtros:"
// no PDF). Em multi-select concatena os nomes selecionados com vírgula.
function flLabel(id){
    if(MS_IDS.has(id)){
        const st = msState[id]; if(!st || !st.sel.size) return '';
        const names = Array.from(st.sel).map(sid => {
            const it = st.items.find(x => String(x.id) === sid);
            return it ? it.nome : sid;
        });
        return names.join(', ');
    }
    const el = document.getElementById(id);
    if(!el) return '';
    if(!el.value) return '';
    return el.options ? (el.options[el.selectedIndex]?.text || '') : el.value;
}

// Fecha qualquer multi-select ao clicar fora
document.addEventListener('click', (e) => {
    if(e.target.closest('.ms-wrap')) return;
    document.querySelectorAll('.ms-panel.open').forEach(p => {
        p.classList.remove('open');
        p.previousElementSibling?.classList.remove('open');
    });
});

