           que altere o fundo da linha. */
        .anexo-badge { display:inline-flex; align-items:center; gap:3px; font-size:10px; font-weight:700; color:#15803d; background:#bbf7d0; padding:2px 6px; border-radius:99px; margin-left:4px; vertical-align:middle; }
